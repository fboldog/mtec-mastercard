; Read-only responsiveness experiment: production driver built with
; MC_IRQ_ROUNDS=1 instead of 4. Validate integrity before measuring it.
FailAt 21
MakeDir RAM:T
Assign T: RAM:T
Echo "MCDevice IRQ-rounds=1 integrity test (read-only)."
MCDiag TAKEOVER LOG RAM:mcdiag-r1.log
Type RAM:mcdiag-r1.log >DF0:mcdiag-r1.log
Echo "Measuring calibrated background CPU availability."
MCCpuBench DEVICE mastercard.device UNIT 1 SECONDS 3 READSIZE 524288 LOG RAM:cpu-mc-r1.log
Type RAM:cpu-mc-r1.log >DF0:cpu-mc-r1.log
Echo "Measuring ordinary throughput without the worker."
Echo "== IRQ rounds 1, devtest pass 1" >RAM:devtest-r1.log
devtest -bb mastercard.device 1 >>RAM:devtest-r1.log
Echo "== IRQ rounds 1, devtest pass 2" >>RAM:devtest-r1.log
devtest -bb mastercard.device 1 >>RAM:devtest-r1.log
Echo "== IRQ rounds 1, devtest pass 3" >>RAM:devtest-r1.log
devtest -bb mastercard.device 1 >>RAM:devtest-r1.log
Echo "== done" >>RAM:devtest-r1.log
Type RAM:devtest-r1.log >DF0:devtest-r1.log
Echo "Done: DF0:mcdiag-r1.log, cpu-mc-r1.log and devtest-r1.log"
